    "install-cli": "bash scripts/install-cli.sh"
  },
  "dependencies": {
    "vue": "^3.5",
    "vue-router": "^4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5",
    "typescript": "^5.6",
    "vite": "^6",
    "vue-tsc": "^2"
  }
