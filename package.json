{
  "name": "cronbox",
  "version": "0.1.0",
  "description": "Local-first CLI scheduler with a browser-based control panel.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoxiunique/cronbox.git"
  },
  "bugs": {
    "url": "https://github.com/xiaoxiunique/cronbox/issues"
  },
  "homepage": "https://github.com/xiaoxiunique/cronbox#readme",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
